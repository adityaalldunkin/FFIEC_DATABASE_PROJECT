# Copy to .env and fill in after registering at CDR PDD (Public Web Service account).
# Registration: https://cdr.ffiec.gov/public/ — Manage My Web Service Account
FFIEC_USER_ID=your_pws_username
FFIEC_TOKEN=your_bearer_token_without_the_Bearer_prefix

# Optional tuning
# FFIEC_FACSIMILE_FORMAT=XBRL
# FFIEC_REQUEST_DELAY_SEC=1.5
# FFIEC_MAX_DOWNLOADS_PER_RUN=10
