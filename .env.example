# Copy to .env and fill in after registering at CDR PDD (Public Web Service account).
# Registration: https://cdr.ffiec.gov/public/ — Manage My Web Service Account
FFIEC_USER_ID=your_pws_username
FFIEC_TOKEN=your_bearer_token_without_the_Bearer_prefix

# Optional tuning
# FFIEC_FACSIMILE_FORMAT=XBRL
# FFIEC_REQUEST_DELAY_SEC=1.5
# FFIEC_MAX_DOWNLOADS_PER_RUN=10

# Lenni deal matcher + borrower chat
# LLM provider: rules (default, no API) | ollama | openai
# LENNI_LLM_PROVIDER=ollama
# LENNI_TASK_ROUTING=true
# LENNI_OLLAMA_MODEL=qwen2.5:14b
# LENNI_OLLAMA_MODEL_CHAT=llama3.3:70b
# LENNI_OLLAMA_MODEL_EXTRACT=qwen2.5:14b
# LENNI_OLLAMA_MODEL_EXTRACT_ALT=deepseek-r1:14b
# OLLAMA_HOST=http://127.0.0.1:11434
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# LENNI_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8000,http://lenni-borrower.s3-website.us-east-2.amazonaws.com
